# Server-only template for /opt/projects/udderly-platform/.env
# Copy to `.env` on the Droplet. Never commit the filled-in file.
# Placeholders only — do not put real credentials here.

NODE_ENV=production

# Must match Traefik load-balancer label (default 3001).
API_PORT=3001
# Production Compose forces 0.0.0.0 so Traefik can reach the container.
# Do not set API_LISTEN_HOST=127.0.0.1 in production.
API_LISTEN_HOST=0.0.0.0

# Public origin for CORS. Frontend is not deployed yet; keep this aligned
# with the hostname Traefik routes to the API.
WEB_ORIGIN=https://goatbarn.udderlyridiculousfarmlife.com

# PostgreSQL 16 (Compose service hostname: postgres). No public port.
# Use a strong unique password. Do not reuse local development `udderly`.
POSTGRES_DB=udderly_platform
POSTGRES_USER=udderly_platform
POSTGRES_PASSWORD=replace-with-strong-unique-password

# Use the same user, password, and database name as above.
# If the password contains URL-special characters, percent-encode them.
DATABASE_URL=postgresql://udderly_platform:replace-with-strong-unique-password@postgres:5432/udderly_platform

# Redis 7 (Compose service hostname: redis). No public port. No Redis AUTH yet;
# isolation is the internal Docker network only.
REDIS_URL=redis://redis:6379

# Optional. The API starts if these are empty.
WHEREWOLF_API_KEY=
WHEREWOLF_APP_ID=

# Optional. The API starts if empty. When set, FareHarbor POSTs to:
# https://goatbarn.udderlyridiculousfarmlife.com/webhooks/fareharbor/<secret>
# Generate a long random value on the server. Never commit it. Never log it.
FAREHARBOR_WEBHOOK_SECRET=

# Optional. The API starts if empty. Production Square credentials only.
# Never commit the access token. Never log it.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# Optional. The API starts if empty. Production GA4 read-only OAuth only.
# Never commit the refresh token or client secret. Never log them.
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# Optional. The API starts if empty. Production Search Console read-only OAuth only.
# Dedicated client/token — never reuse GA. Never commit the refresh token or client secret.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# Optional. The API starts if empty. Read-only Marketing API token only.
# Never commit the access token. Never log it. Do not enable writes.
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# Optional. The API starts if empty. Dedicated Mailchimp Marketing API key.
# Never reuse the Wherewolf Mailchimp key. Never commit the key. GET-only ingest.
MAILCHIMP_API_KEY=

# Gift-card naming campaign. Leave false until launch.
# Public /naming routes stay disabled unless this is exactly true.
NAMING_CAMPAIGN_ENABLED=false

# Staff-only test checkout. Leave empty. A UUID does not enable the campaign.
NAMING_TEST_CHECKOUT_OBJECT_ID=

# FareHarbor tier items. Leave empty until FareHarbor confirms each item pk and
# flow id. Empty keeps item 308290 and flow 573099 for $100, $250, $500, and
# $1,000. Set the same value on the API and website. A partial value stops the API.
# See docs/fareharbor-tier-checkout.md.
NAMING_FAREHARBOR_TIERS=

# Naming-link email. Leave these empty until launch. A partial Resend or SMTP set stops the API.
# Production sends through Resend over HTTPS. RESEND_FROM is on the verified domain.
# RESEND_REPLY_TO is the marketing mailbox. Gmail SMTP is only the local fallback.
# When both are set, Resend is used. Set NAMING_PUBLIC_BASE_URL before any send.
# NAMING_PUBLIC_BASE_URL=https://giftcard.udderlyridiculousfarmlife.com
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
NAMING_PUBLIC_BASE_URL=

# Staff inventory. Leave both empty until staff should sign in. A partial pair stops the API.
# These do not enable purchasing. Generate the signing key with: openssl rand -base64 32
# The password is at least 12 characters. The signing key is at least 32 characters.
NAMING_ADMIN_PASSWORD=
NAMING_ADMIN_SESSION_SECRET=

# Temporary website preview. The web container only. Leave the campaign flag false.
# Shows sample objects and keeps buying turned off. Set to false to hide the preview.
# NAMING_PREVIEW_MODE=true

# Temporary Basic Auth for giftcard.udderlyridiculousfarmlife.com only.
# One htpasswd user:hash. Double every $ so Compose keeps the hash intact.
# Generate on the server and do not commit the result:
#   htpasswd -nbB campaign 'choose-a-password' | sed 's/\$/\$\$/g'
GIFT_CARD_BASIC_AUTH=
