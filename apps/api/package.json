{
  "name": "@udderly/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint src drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "audit:wherewolf": "tsx src/integrations/wherewolf/audit-wherewolf.cli.ts",
    "audit:square": "tsx src/integrations/square/square-audit.cli.ts",
    "test:fareharbor-webhook": "tsx --test src/common/redact-webhook-path.middleware.spec.ts src/integrations/fareharbor/fareharbor-webhook.service.spec.ts && tsx src/integrations/fareharbor/test-fareharbor-webhook.cli.ts",
    "integrations:recover": "tsx src/integrations/recover-integration-events.cli.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@udderly/shared": "*",
    "bullmq": "^5.58.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^5.7.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2"
  }
}
