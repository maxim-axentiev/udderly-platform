{
  "name": "@udderly/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint src drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "audit:wherewolf": "tsx src/integrations/wherewolf/audit-wherewolf.cli.ts",
    "audit:square": "tsx src/integrations/square/square-audit.cli.ts",
    "test:fareharbor-webhook": "tsx --test src/common/redact-webhook-path.middleware.spec.ts src/integrations/fareharbor/fareharbor-webhook.service.spec.ts src/integrations/fareharbor/fareharbor.snapshot.spec.ts && tsx src/integrations/fareharbor/test-fareharbor-webhook.cli.ts && tsx src/integrations/fareharbor/test-fareharbor-map.cli.ts",
    "integrations:recover": "node dist/integrations/recover-integration-events.cli.js",
    "integrations:recover:dev": "tsx src/integrations/recover-integration-events.cli.ts",
    "normalize:fareharbor": "node dist/integrations/fareharbor/normalize-fareharbor.cli.js",
    "normalize:fareharbor:dev": "tsx src/integrations/fareharbor/normalize-fareharbor.cli.ts",
    "map:fareharbor-experience": "node dist/integrations/fareharbor/map-fareharbor-experience.cli.js",
    "map:fareharbor-experience:dev": "tsx src/integrations/fareharbor/map-fareharbor-experience.cli.ts",
    "import:fareharbor-report": "node dist/integrations/fareharbor/import-fareharbor-report.cli.js",
    "import:fareharbor-report:dev": "tsx src/integrations/fareharbor/import-fareharbor-report.cli.ts",
    "map:fareharbor-report-item": "node dist/integrations/fareharbor/map-fareharbor-report-item.cli.js",
    "map:fareharbor-report-item:dev": "tsx src/integrations/fareharbor/map-fareharbor-report-item.cli.ts",
    "classify:fareharbor-report-item": "node dist/integrations/fareharbor/classify-fareharbor-report-item.cli.js",
    "classify:fareharbor-report-item:dev": "tsx src/integrations/fareharbor/classify-fareharbor-report-item.cli.ts",
    "test:fareharbor-report": "tsx --test src/integrations/fareharbor/fareharbor-report.parse.spec.ts src/integrations/fareharbor/fareharbor-report.time.spec.ts && tsx src/integrations/fareharbor/test-fareharbor-report.cli.ts",
    "test:fareharbor-map": "tsx src/integrations/fareharbor/test-fareharbor-map.cli.ts",
    "import:wherewolf": "node dist/integrations/wherewolf/import-wherewolf.cli.js",
    "import:wherewolf:dev": "tsx src/integrations/wherewolf/import-wherewolf.cli.ts",
    "map:wherewolf-experience": "node dist/integrations/wherewolf/map-wherewolf-experience.cli.js",
    "map:wherewolf-experience:dev": "tsx src/integrations/wherewolf/map-wherewolf-experience.cli.ts",
    "normalize:wherewolf": "node dist/integrations/wherewolf/normalize-wherewolf.cli.js",
    "normalize:wherewolf:dev": "tsx src/integrations/wherewolf/normalize-wherewolf.cli.ts",
    "inspect:wherewolf": "node dist/integrations/wherewolf/inspect-wherewolf.cli.js",
    "inspect:wherewolf:dev": "tsx src/integrations/wherewolf/inspect-wherewolf.cli.ts",
    "resanitize:wherewolf": "node dist/integrations/wherewolf/resanitize-wherewolf.cli.js",
    "resanitize:wherewolf:dev": "tsx src/integrations/wherewolf/resanitize-wherewolf.cli.ts",
    "test:wherewolf-import": "tsx --test src/integrations/wherewolf/wherewolf.sanitize.spec.ts src/integrations/wherewolf/wherewolf.range.spec.ts src/integrations/wherewolf/wherewolf.occurrence.spec.ts src/integrations/wherewolf/wherewolf.activity.spec.ts src/integrations/wherewolf/wherewolf-inspect.spec.ts && tsx src/integrations/wherewolf/test-wherewolf-import.cli.ts",
    "import:square-catalog": "node dist/integrations/square/import-square-catalog.cli.js",
    "import:square-catalog:dev": "tsx src/integrations/square/import-square-catalog.cli.ts",
    "normalize:square-catalog": "node dist/integrations/square/normalize-square-catalog.cli.js",
    "normalize:square-catalog:dev": "tsx src/integrations/square/normalize-square-catalog.cli.ts",
    "recover:square-catalog": "node dist/integrations/square/recover-square-catalog.cli.js",
    "recover:square-catalog:dev": "tsx src/integrations/square/recover-square-catalog.cli.ts",
    "recover:square-payment-orders": "node dist/integrations/square/recover-square-payment-orders.cli.js",
    "recover:square-payment-orders:dev": "tsx src/integrations/square/recover-square-payment-orders.cli.ts",
    "test:square-payment-order-recovery": "tsx --test src/integrations/square/square.commerce.payment-order-recovery.spec.ts src/integrations/square/square.client.commerce.spec.ts && tsx src/integrations/square/test-square-payment-order-recovery.cli.ts",
    "test:square-catalog-recovery": "tsx --test src/integrations/square/square.catalog.recovery.spec.ts src/integrations/square/square.client.catalog.spec.ts && tsx src/integrations/square/test-square-catalog-recovery.cli.ts",
    "test:square-catalog": "tsx --test src/integrations/square/square.catalog.sanitize.spec.ts src/integrations/square/square.client.catalog.spec.ts src/integrations/square/square.catalog.recovery.spec.ts && tsx src/integrations/square/test-square-catalog.cli.ts",
    "import:square-commerce": "node dist/integrations/square/import-square-commerce.cli.js",
    "import:square-commerce:dev": "tsx src/integrations/square/import-square-commerce.cli.ts",
    "normalize:square-commerce": "node dist/integrations/square/normalize-square-commerce.cli.js",
    "normalize:square-commerce:dev": "tsx src/integrations/square/normalize-square-commerce.cli.ts",
    "reconcile:square-commerce": "node dist/integrations/square/reconcile-square-commerce.cli.js",
    "reconcile:square-commerce:dev": "tsx src/integrations/square/reconcile-square-commerce.cli.ts",
    "inspect:square-commerce": "node dist/integrations/square/inspect-square-commerce.cli.js",
    "inspect:square-commerce:dev": "tsx src/integrations/square/inspect-square-commerce.cli.ts",
    "backfill:square-commerce": "node dist/integrations/square/backfill-square-commerce.cli.js",
    "backfill:square-commerce:dev": "tsx src/integrations/square/backfill-square-commerce.cli.ts",
    "test:square-backfill": "tsx --test src/integrations/square/square.commerce.backfill.spec.ts",
    "test:square-commerce": "tsx --test src/integrations/square/square.commerce.sanitize.spec.ts src/integrations/square/square.commerce.money.spec.ts src/integrations/square/square.commerce.line.spec.ts src/integrations/square/square.client.commerce.spec.ts src/integrations/square/square.commerce.reconcile.spec.ts src/integrations/square/square.commerce.inspect.spec.ts && tsx src/integrations/square/test-square-commerce.cli.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@udderly/shared": "*",
    "bullmq": "^5.58.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^5.7.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76",
    "drizzle-kit": "^0.31.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
