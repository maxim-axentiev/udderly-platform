# Copy this file to `.env` in the repository root.
# Do not commit `.env`.

NODE_ENV=development

# NestJS API
API_PORT=3001
# Local default is 127.0.0.1 (see env validation). Production Compose sets 0.0.0.0.
# API_LISTEN_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# PostgreSQL 16 (Docker Compose)
POSTGRES_USER=udderly
POSTGRES_PASSWORD=udderly
POSTGRES_DB=udderly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://udderly:udderly@127.0.0.1:5432/udderly

# Redis 7 (Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
WEB_PORT=3000

# Wherewolf (optional). The API starts without these.
# WHEREWOLF_APP_ID is sent as Wherewolf's `pool` value.
WHEREWOLF_API_KEY=
WHEREWOLF_APP_ID=

# FareHarbor webhook (optional). The API starts without this.
# Used as the secret URL path: POST /webhooks/fareharbor/<secret>
# Use a long random value. Never commit it. FareHarbor does not send HMAC signatures.
FAREHARBOR_WEBHOOK_SECRET=

# Square (optional). The API starts without these.
# Production credentials only. Access token must never be committed or logged.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# Google Analytics (optional). The API starts without these.
# Read-only OAuth (analytics.readonly). Never commit tokens or client secrets.
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# Google Search Console (optional). The API starts without these.
# Read-only OAuth (webmasters.readonly). Dedicated client/token — never reuse GA.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# Meta Ads (optional). The API starts without these.
# Read-only Graph token. Never commit tokens. Local tests do not need a token.
# Both vars are required together. Account id must be act_1818645281666685.
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Production (Droplet) — do not use these values locally.
# Copy `.env.production.example` to `/opt/projects/udderly-platform/.env`
# on the server. Never commit production secrets. Never reuse POSTGRES_PASSWORD=udderly.
#
# NODE_ENV=production
# API_PORT=3001
# WEB_ORIGIN=https://goatbarn.udderlyridiculousfarmlife.com
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB
# REDIS_URL=redis://redis:6379
# WHEREWOLF_API_KEY=
# WHEREWOLF_APP_ID=
# FAREHARBOR_WEBHOOK_SECRET=
# SQUARE_ACCESS_TOKEN=
# SQUARE_APPLICATION_ID=
# SQUARE_LOCATION_ID=
# GOOGLE_ANALYTICS_PROPERTY_ID=
# GOOGLE_ANALYTICS_CLIENT_ID=
# GOOGLE_ANALYTICS_CLIENT_SECRET=
# GOOGLE_ANALYTICS_REFRESH_TOKEN=
# GOOGLE_SEARCH_CONSOLE_SITE_URL=
# GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
# GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
# GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
# META_ADS_ACCOUNT_ID=
# META_ADS_ACCESS_TOKEN=
# -----------------------------------------------------------------------------
